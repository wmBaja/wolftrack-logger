# ==============================================================================
# CAN Bus Configuration
# ==============================================================================

# CAN interface type (socketcan, pcan, kvaser, virtual, etc.)
CAN_INTERFACE=socketcan

# CAN channel name (can0, can1, vcan0, etc.)
# For Waveshare HAT: typically can0 or can1
CAN_CHANNEL=can0

# CAN bitrate in bits per second
# Common values: 125000, 250000, 500000, 1000000
CAN_BITRATE=1000000

# Enable CAN-FD support (true/false)
CAN_FD=true

# CAN-FD data phase bitrate (only used if CAN_FD=true)
# Should be higher than CAN_BITRATE
# Common values: 2000000, 4000000, 5000000
CAN_DATA_BITRATE=2000000

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Directory for MDF4 log files (absolute or relative path)
LOG_OUTPUT_DIR=./logs

# Directory for DBC database files
DBC_DIR=./dbc

# Maximum MDF4 file size in MB before starting a new file
# Set to 0 for unlimited
LOG_MAX_FILE_SIZE_MB=150

# BLF compression level
# 0-9 = no compression to most compression
# -1 = default compression
LOG_COMPRESSION=-1

# Message buffer size (number of CAN messages to buffer)
# Larger = more memory usage, less likely to drop messages
# Smaller = less memory, might drop messages under heavy load
LOG_BUFFER_SIZE=10000

LOG_FILE_TEMPLATE=log_%T.mf4

# ==============================================================================
# Application Logging (not MDF4 files)
# ==============================================================================

# Directory for application log files (Flask logs, errors, etc.)
APP_LOG_DIR=./app_logs

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG = very verbose, use for development
# INFO = normal operations, use for production
# WARNING = only warnings and errors
APP_LOG_LEVEL=INFO

# Enable/disable console output
APP_LOG_TO_CONSOLE=true

# Enable/disable logging to file
APP_LOG_TO_FILE=true

# Max size of application log file in MB before rotation
APP_LOG_MAX_FILE_SIZE_MB=10

# Max number of application log files to keep (0 = unlimited)
APP_LOG_BACKUP_COUNT=5

# Format of application log messages
# Options: simple, detailed
APP_LOG_FORMAT=detailed

# ==============================================================================
# Flask/API Configuration
# ==============================================================================

# Host to bind Flask server to
# 0.0.0.0 = accessible from any network interface
# 127.0.0.1 = only accessible from localhost
FLASK_HOST=0.0.0.0

# Port for Flask API
FLASK_PORT=5500

# Enable Flask debug mode (true/false)
# WARNING: Never enable in production!
FLASK_DEBUG=false

# Enable CORS (Cross-Origin Resource Sharing)
# Set to false if API is only accessed from same origin
ENABLE_CORS=true

# ==============================================================================
# Optional: Advanced Settings
# ==============================================================================

# Automatically load all DBC files on startup (true/false)
AUTO_LOAD_DBC=true

# Default DBC file to use (filename in DBC_DIR)
# Leave empty to not set a default
DEFAULT_DBC=

# Session name prefix (added to all session names)
SESSION_NAME_PREFIX=

# Timezone for timestamps (e.g., UTC, America/New_York, Europe/London)
# Leave empty to use system timezone
TIMEZONE=